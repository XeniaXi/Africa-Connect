# Database
DATABASE_URL=postgresql://connectafrica:connectafrica_dev@localhost:5432/connectafrica

# Redis
REDIS_URL=redis://localhost:6379

# OpenSearch
OPENSEARCH_NODE=http://localhost:9200

# MinIO / S3
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=connectafrica

# API
API_PORT=4000
JWT_SECRET=change-me-in-production-use-32-char-minimum
PUBLIC_BASE=http://localhost:4000
# Comma-separated list of allowed CORS origins (production: set to your actual domains)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# MCP Gateway
MCP_PORT=4001
MCP_PUBLIC_BASE=http://localhost:4001
API_BASE=http://localhost:4000

# Web Portal (Next.js, port 3000)
NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Admin Portal (Next.js, port 3001)
# NEXT_PUBLIC_API_URL=http://localhost:4000/v1   (same var, set per Coolify resource)
ADMIN_JWT=                                        # long-lived admin JWT for server-side API calls

# Node
NODE_ENV=development
