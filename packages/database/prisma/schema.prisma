generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BusinessStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING_REVIEW
}

enum ClaimStatus {
  PENDING
  APPROVED
  REJECTED
  DISPUTED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  EXPIRED
  FAILED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  CLOSED
}

enum ActorType {
  USER
  PARTNER
  ADMIN
  AGENT
  SYSTEM
}

model Category {
  id          String     @id @default(uuid())
  slug        String     @unique
  name        String
  parentId    String?
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  businesses  Business[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("categories")
}

model PartnerSource {
  id              String     @id @default(uuid())
  name            String     @unique
  slug            String     @unique
  sourceType      String
  apiKeyHash      String?
  trustWeight     Decimal    @default(1.0)
  status          String     @default("active")
  webhookUrl      String?
  lastSyncAt      DateTime?
  businesses      Business[]
  syncLogs        SyncLog[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("partner_sources")
}

model Business {
  id                  String          @id @default(uuid())
  externalId          String?
  sourceId            String?
  source              PartnerSource?  @relation(fields: [sourceId], references: [id])
  canonicalName       String
  displayName         String
  categoryId          String
  category            Category        @relation(fields: [categoryId], references: [id])
  description         String?
  phone               String?
  email               String?
  website             String?
  slug                String?         @unique
  status              BusinessStatus  @default(ACTIVE)
  verificationLevel   Int             @default(0)
  trustScore          Int             @default(0)
  availabilityStatus  String          @default("unknown")
  claimedByUserId     String?         // set when a user successfully claims this profile
  claimedAt           DateTime?
  lastVerifiedAt      DateTime?
  lastSyncedAt        DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  locations           BusinessLocation[]
  claims              BusinessClaim[]
  verifications       VerificationRecord[]
  reviews             Review[]
  bookings            Booking[]
  leads               Lead[]
  trustHistory        TrustScoreHistory[]
  searchEvents        SearchEvent[]
  services            BusinessService[]

  @@unique([sourceId, externalId])
  @@index([categoryId])
  @@index([trustScore])
  @@index([verificationLevel])
  @@map("businesses")
}

model BusinessLocation {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  address     String?
  city        String
  state       String
  country     String   @default("Nigeria")
  latitude    Decimal? @db.Decimal(10, 7)
  longitude   Decimal? @db.Decimal(10, 7)
  geohash     String?
  isPrimary   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([businessId])
  @@index([city, state])
  @@index([geohash])
  @@map("business_locations")
}

model BusinessService {
  id          String   @id @default(uuid())
  businessId  String
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  name        String
  description String?
  tags        String[]
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([businessId])
  @@map("business_services")
}

model User {
  id           String          @id @default(uuid())
  email        String?         @unique
  phone        String?         @unique
  displayName  String?
  role         String          @default("user")
  isActive     Boolean         @default(true)
  claims       BusinessClaim[]
  reviews      Review[]
  apiKeys      ApiKey[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("users")
}

model ApiKey {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  name        String
  keyHash     String   @unique
  scopes      String[]
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("api_keys")
}

model BusinessClaim {
  id              String      @id @default(uuid())
  businessId      String
  business        Business    @relation(fields: [businessId], references: [id])
  claimantUserId  String?
  claimant        User?       @relation(fields: [claimantUserId], references: [id])
  claimMethod     String
  claimStatus     ClaimStatus @default(PENDING)
  evidenceUrl     String?
  evidenceNotes   String?
  reviewedBy      String?
  reviewedAt      DateTime?
  reviewNotes     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([businessId])
  @@index([claimStatus])
  @@map("business_claims")
}

model VerificationRecord {
  id                  String             @id @default(uuid())
  businessId          String
  business            Business           @relation(fields: [businessId], references: [id])
  verificationType    String
  verificationStatus  VerificationStatus @default(PENDING)
  provider            String?
  evidence            Json?
  verifiedBy          String?
  expiresAt           DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([businessId])
  @@index([verificationStatus])
  @@map("verification_records")
}

model Review {
  id                    String   @id @default(uuid())
  businessId            String
  business              Business @relation(fields: [businessId], references: [id])
  sourceId              String?
  userId                String?
  user                  User?    @relation(fields: [userId], references: [id])
  rating                Int
  comment               String?
  verifiedTransaction   Boolean  @default(false)
  isPublished           Boolean  @default(true)
  createdAt             DateTime @default(now())

  @@index([businessId])
  @@index([rating])
  @@map("reviews")
}

model TrustScoreHistory {
  id                        String   @id @default(uuid())
  businessId                String
  business                  Business @relation(fields: [businessId], references: [id])
  score                     Int
  verificationScore         Decimal
  reviewQualityScore        Decimal
  transactionScore          Decimal
  responseTimeScore         Decimal
  complaintHistoryScore     Decimal
  freshnessScore            Decimal
  partnerConfidenceScore    Decimal
  computedAt                DateTime @default(now())

  @@index([businessId])
  @@map("trust_score_history")
}

model Booking {
  id              String        @id @default(uuid())
  businessId      String
  business        Business      @relation(fields: [businessId], references: [id])
  customerName    String
  customerPhone   String?
  customerEmail   String?
  serviceNote     String?
  status          BookingStatus @default(PENDING)
  scheduledAt     DateTime?
  confirmedAt     DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  sourceChannel   String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([businessId])
  @@index([status])
  @@map("bookings")
}

model Lead {
  id              String     @id @default(uuid())
  businessId      String
  business        Business   @relation(fields: [businessId], references: [id])
  customerName    String?
  customerPhone   String?
  customerEmail   String?
  message         String?
  status          LeadStatus @default(NEW)
  sourceChannel   String?
  sourcePartner   String?
  convertedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([businessId])
  @@index([status])
  @@map("leads")
}

model SearchEvent {
  id              String    @id @default(uuid())
  query           String
  category        String?
  city            String?
  state           String?
  resultCount     Int
  topBusinessId   String?
  topBusiness     Business? @relation(fields: [topBusinessId], references: [id])
  actorId         String?
  actorType       ActorType @default(AGENT)
  durationMs      Int?
  createdAt       DateTime  @default(now())

  @@index([category, city])
  @@index([actorType])
  @@map("search_events")
}

model SyncLog {
  id            String        @id @default(uuid())
  sourceId      String
  source        PartnerSource @relation(fields: [sourceId], references: [id])
  recordsTotal  Int
  recordsUpserted Int
  recordsErrors Int           @default(0)
  errorDetails  Json?
  durationMs    Int?
  startedAt     DateTime      @default(now())
  completedAt   DateTime?

  @@index([sourceId])
  @@map("sync_logs")
}

model AuditLog {
  id          String    @id @default(uuid())
  requestId   String?
  actorId     String?
  actorType   ActorType @default(SYSTEM)
  tenantId    String?
  action      String
  resource    String
  resourceId  String?
  scopes      String[]
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([actorId])
  @@index([resource, resourceId])
  @@index([createdAt])
  @@map("audit_logs")
}
